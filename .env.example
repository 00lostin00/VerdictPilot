# The offline provider exercises retrieval, execution, memory, and tracing without an API key.
VERDICTPILOT_PROVIDER=offline

# Used only when VERDICTPILOT_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Safe default: code execution is disabled.
# Options: disabled, docker, local
VERDICTPILOT_EXECUTION_BACKEND=disabled
VERDICTPILOT_DOCKER_IMAGE=verdictpilot-sandbox:latest

# Local execution is for trusted teaching examples only. Never enable it for public input.
VERDICTPILOT_ALLOW_UNSAFE_LOCAL_EXECUTION=false

VERDICTPILOT_COMPILE_TIMEOUT_SECONDS=15
VERDICTPILOT_RUN_TIMEOUT_SECONDS=2
VERDICTPILOT_MAX_OUTPUT_BYTES=65536

# Optional for installed wheels / containers. Relative paths resolve from the working directory.
# VERDICTPILOT_PROJECT_ROOT=/app
# VERDICTPILOT_DATA_DIR=/app/data
